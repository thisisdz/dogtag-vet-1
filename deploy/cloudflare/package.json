{
  "name": "dogtag-verify-cloudflare",
  "private": true,
  "description": "Cloudflare Worker + Containers that run DogTag's manual verification deployment at verify.dogtagapp.com",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
